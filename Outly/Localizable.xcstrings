          "stringUnit": {
            "state": "translated",
            "value": "E-pošta prijateljevega Outly računa"
          }
        }
      }
    },
    "Your friend's account is not verified yet.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijateljev račun še ni potrjen."
          }
        }
      }
    },
    "Your friends' plans": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Načrti prijateljev"
          }
        }
      }
    },
    "Your home country.": {
      "extractionState": "manual",
      "localizations": {
