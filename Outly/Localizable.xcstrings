          }
        }
      }
    },
    "The ticket moves to your friend's account with a new QR code. Your copy stops working. Your friend needs an Outly account and must be %lld+.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vstopnica se prenese na prijateljev račun z novo kodo QR. Tvoja kopija preneha delovati. Prijatelj potrebuje Outly račun in mora biti star %lld+."
          }
        }
      }
    },
    "The ticket moves to your friend's account with a new QR code. Your copy stops working. Your friend needs an Outly account.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vstopnica se prenese na prijateljev račun z novo kodo QR. Tvoja kopija preneha delovati. Prijatelj potrebuje Outly račun."
          }
        }
      }
    },
