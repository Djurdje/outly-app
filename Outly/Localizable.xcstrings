    "Payments aren't set up yet. Contact Outly.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plačila še niso nastavljena. Piši Outlyju."
          }
