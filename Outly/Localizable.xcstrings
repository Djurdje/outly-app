            "value": "Pomikaj se navzdol in prebrskaj razdelke."
          }
        }
      }
    },
    "Tap any card to open it.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapni katerokoli kartico, da jo odpreš."
          }
        }
