          }
        }
      }
    },
    "Home is a feed of what is on, shown in sections.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Domov je pregled dogajanja, razdeljen na razdelke."
          }
        }
      }
    },
    "Scroll down to browse the sections.": {
      "extractionState": "manual",
      "localizations": {
