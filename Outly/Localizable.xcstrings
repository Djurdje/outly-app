            "value": "Povleci navzdol za osvežitev."
          }
        }
      }
    },
    "Everything you can do in Outly is explained in the Help Center — use its search field to jump to an article.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
