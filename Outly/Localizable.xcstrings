            "state": "translated",
            "value": "Še ni prodaje."
          }
        }
      }
    },
    "No tickets sold for this event yet.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za ta dogodek še ni prodanih vstopnic."
          }
