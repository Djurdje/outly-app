    "Tap Sign up.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapni Registracija."
          }
        }
      }
    },
    "Enter your username, email and a password.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vnesi uporabniško ime, e-pošto in geslo."
          }
        }
      }
    },
    "Type in the code (6–10 digits) we send to your email to confirm your address.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
