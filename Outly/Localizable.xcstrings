    "You already have an application waiting for review.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Že imaš prošnjo, ki čaka na pregled."
          }
        }
      }
    },
    "You have an unfinished payment. Finish it, or wait up to 30 minutes for it to expire.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Imaš nedokončano plačilo. Dokončaj ga ali počakaj do 30 minut, da poteče."
          }
        }
      }
    },
    "You are already in a club team. Leave it first.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Že si v ekipi kluba. Najprej jo zapusti."
          }
        }
      }
    },
    "You are currently not working\nfor any club": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenutno ne delaš\nza noben klub"
          }
        }
      }
    },
    "You are not in a club team.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nisi v ekipi nobenega kluba."
          }
        }
      }
    },
    "You can change this any time in iOS Settings.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To lahko kadar koli spremeniš v nastavitvah iOS."
          }
        }
      }
    },
    "You can change your password at any time.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geslo lahko spremeniš kadar koli."
          }
        }
      }
    },
    "You can only manage events of your own club.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Urejaš lahko samo dogodke lastnega kluba."
          }
        }
      }
    },
    "You do not have permission to do that.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za to nimaš dovoljenja."
          }
        }
      }
    },
    "You have reached the limit of blocked users.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosežena je omejitev števila blokiranih uporabnikov."
          }
        }
      }
    },
    "You haven't blocked anyone.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikogar nimaš blokiranega."
          }
        }
      }
    },
    "You lose access to the club tools. The club can invite you again.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izgubiš dostop do orodij za klub. Klub te lahko znova povabi."
          }
        }
      }
    },
    "You must be 15 or older to use Outly. Some events are 18+ — this is shown on the event and you need a date of birth in your profile to buy tickets for them.\n\nThe club may ask for an ID at the door.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za uporabo Outlyja moraš imeti vsaj 15 let. Nekateri dogodki so 18+ — to je označeno pri dogodku, za nakup vstopnic pa potrebuješ datum rojstva v profilu.\n\nKlub lahko pri vhodu zahteva osebni dokument."
          }
        }
      }
    },
    "You must be at least 15 years old to use Outly.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za uporabo Outlyja moraš biti star vsaj 15 let."
          }
        }
      }
    },
    "You own a club, so you can't join another team.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lastnik si kluba, zato se ne moreš pridružiti drugi ekipi."
          }
        }
      }
    },
    "You will be signed out on this device too.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odjavljen boš tudi na tej napravi."
          }
        }
      }
    },
    "You will no longer see each other's plans. You can add them again later.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne bosta več videla načrtov drug drugega. Lahko ga dodaš znova."
          }
        }
      }
    },
    "Your current tables and prices for this event are replaced by a fresh copy of the venue's layout.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenutne mize in cene tega dogodka zamenja nova kopija razporeda prizorišča."
          }
        }
      }
    },
    "You're in!": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vstopnice so tvoje!"
          }
        }
      }
    },
    "Your application was approved. Log out and log in again to switch to your business account.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoja prošnja je bila odobrena. Odjavi se in se znova prijavi, da preklopiš na poslovni račun."
          }
        }
      }
    },
    "Your business account is active. Manage your club and events from your profile.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj poslovni račun je aktiven. Klub in dogodke upravljaj v svojem profilu."
          }
        }
      }
    },
    "Your club": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj klub"
          }
        }
      }
    },
    "Your club has sold tickets. Transfer club ownership before deleting your account.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj klub je prodal vstopnice. Pred brisanjem računa predaj lastništvo kluba."
          }
        }
      }
    },
    "Your club is not set up yet.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj klub še ni nastavljen."
          }
        }
      }
    },
    "Your club is not set up yet. Contact luka@outly.si to get it created.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj klub še ni ustvarjen. Piši na luka@outly.si, da ga uredimo."
          }
        }
      }
    },
    "Your club is not set up yet. Fill in the club info first.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj klub še ni urejen. Najprej izpolni podatke o klubu."
          }
        }
      }
    },
    "Your copy stops working.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoja kopija preneha delovati."
          }
        }
      }
    },
    "Your email is not verified yet.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj e-naslov še ni potrjen."
          }
        }
      }
    },
    "Your email is used for login and important notifications. To change it, contact luka@outly.si.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "E-pošto uporabljaš za prijavo in pomembna obvestila. Za spremembo piši na luka@outly.si."
          }
        }
      }
    },
    "Your friend is too young for this event.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijatelj je premlad za ta dogodek."
          }
        }
      }
    },
    "Your friend must add a date of birth in the app before receiving this ticket.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
