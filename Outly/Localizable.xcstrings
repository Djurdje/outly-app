    },
    "The tables and prices drawn for this event are lost. Tables with orders stay archived and those orders stay valid. Phone reservations on these tables are released.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Narisani tloris, mize in cene tega dogodka se izgubijo. Mize z naročili ostanejo arhivirane in ta naročila veljajo. Telefonske rezervacije na teh mizah se sprostijo."
          }
        }
      }
    },
    "the venue": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "prizorišče"
          }
        }
      }
    },
    "They won't be able to find you or send you requests. They won't be notified.": {
