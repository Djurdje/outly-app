          "stringUnit": {
            "state": "translated",
            "value": "Tapni ikono drsnikov ob Kam gremo?."
          }
        }
      }
    },
    "Choose a City and tick Music genres.": {
      "extractionState": "manual",
      "localizations": {
        "sl": {
          "stringUnit": {
