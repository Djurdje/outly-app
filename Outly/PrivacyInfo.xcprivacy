<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Manifest zasebnosti (obvezen od maja 2024). Brez njega App Store Connect
	oddajo zavrne ze pri nalaganju (ITMS-91053), pred pregledom.

	Vsebina mora ustrezati:
	  - razdelku 11 v pravno/politika-zasebnosti.html (tabela za App Store Connect),
	  - dejanski kodi: aplikacija NE sledi uporabnikom, NE uporablja tretjih SDK-jev
	    za analitiko/oglase, lokacija ostane NA NAPRAVI (ne posilja se na streznik).
	    Edini tretji SDK je Sentry Cocoa (porocanje zrusitev, samo Release na napravi; Services/Napake.swift,
	    backend#87): njegovi podatkovni tipi so spodaj (CrashData, PerformanceData, OtherDiagnosticData).
	Ce se karkoli od tega spremeni (npr. lokacija na streznik), popravi TO datoteko,
	razdelek 11 politike in izjavo v App Store Connect hkrati.
	-->

	<!-- Ne sledimo uporabnikom (brez ATT, brez oglasnih identifikatorjev). -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- API-ji z obveznim razlogom, ki jih koda uporablja. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- UserDefaults: @AppStorage (authStage, pendingEmail, loginNotice, maxDistanceKm)
			     in enkratna selitev starega zetona v Keychain. Samo lastni podatki aplikacije. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<!-- Cas zadnje spremembe datoteke v mapi aplikacije (Application Support/Sken, SkenVrsta.swift
			     spremenjeno(_:) -> attributesOfItem .modificationDate): kdaj je bil prenesen seznam vstopnic
			     za sken brez povezave. Samo datoteke, ki jih je ustvarila sama aplikacija. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<!-- Sentry Cocoa (staticno vezan): cas zagona sistema za merjenje casa od zagona aplikacije
			     (Sentryjev lastni manifest deklarira isti razlog). Aplikacija sama tega API-ja ne klice. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
	</array>

	<!-- Podatki, ki jih aplikacija poslje na streznik (Outly backend). -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhoneNumber</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- Uporabnisko ime. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- Profilna slika (Cloudinary). -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhotosorVideos</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- Datum rojstva, drzava, glasbene zvrsti (dokoncanje racuna). -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDataTypes</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- Zgodovina nakupov: narocila vstopnic in miz (POST /events/:id/orders, GET /me/orders). Placilne podatke obdela Stripe na svoji strani; aplikacija kartice nikoli ne vidi. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePurchaseHistory</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- Nakljucni UUID namestitve za sken brez povezave (SkenSeja.swift SkenNaprava.id, device_id v scan-batch); samo osebje kluba. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- Social graph: prijatelji, prosnje, sledenje klubom (APIClient+Friends, +Follows). Imenika telefona aplikacija NE bere. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeContacts</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- Prijave zlorabe z neobveznim besedilom (POST /reports, APIClient+Reports.swift sendReport, najvec 1000 znakov). -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- Interakcija: POST /views steje oglede kluba/dogodka (brez uporabnika, agregiran dnevni stevec; Analytics), poleg tega uporabnikovi priljubljeni, nacrti in sledenja (AppFunctionality, vezano na racun). Ker je del vezan na racun, je Linked=true. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<dict>
			<!-- Sentry Cocoa: Zrusitve aplikacije (sklad, razlicica aplikacije in iOS, model naprave). Ni vezano na uporabnika (user in zahtevek se pred posiljanjem odstranita, Napake.swift). -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCrashData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- Sentry Cocoa: Sentry SDK jo deklarira v svojem manifestu (zagon aplikacije, release health: stevilo sej). Tracing je ugasnjen (tracesSampleRate = 0). Ni vezano na uporabnika (user in zahtevek se pred posiljanjem odstranita, Napake.swift). -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePerformanceData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- Sentry Cocoa: Diagnostika SDK in sistema ob napaki (npr. stanje pomnilnika, jezik, razlicica). Ni vezano na uporabnika (user in zahtevek se pred posiljanjem odstranita, Napake.swift). -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDiagnosticData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!--
		NI navedeno (namerno):
		  - Precise/Coarse Location: lokacija ostane NA NAPRAVI (LocationManager, razdalja se racuna lokalno).
		    Koordinate v PATCH /clubs so koordinate KLUBA iz CLGeocoderja, ne uporabnika.
		  - Device ID: Apple potisni zeton (POST /me/devices) po Applovi razlagi NI Device ID. Ko je odlocitev o
		    nakljucnem UUID-ju namestitve za sken (SkenNaprava, device_id v scan-batch) sprejeta, popravi TO datoteko.
		  - Advertising data: aplikacija nima oglasnih SDK-jev. (Crash/Performance data: od backend#87 je naveden zgoraj, Sentry.)
		-->
	</array>
</dict>
</plist>
